{
  "name": "systemdesignjury",
  "productName": "System Design Jury",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:preload": "webpack --config webpack.preload.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev:main": "webpack --config webpack.main.config.js",
    "dev:preload": "webpack --config webpack.preload.config.js",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js",
    "dev:electron": "wait-on http://localhost:3000 && NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac dmg",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder --mac dmg --win --linux"
  },
  "keywords": [],
  "author": {
    "name": "smathpal",
    "email": "smathpal@users.noreply.github.com"
  },
  "homepage": "https://github.com/smathpal/systemdesignjury",
  "license": "ISC",
  "build": {
    "appId": "com.systemdesignjury.app",
    "productName": "System Design Jury",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/Jury.png",
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/Jury.png",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "assets/Jury.png",
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^1.16.0",
    "ollama": "^0.6.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.13"
  }
}
